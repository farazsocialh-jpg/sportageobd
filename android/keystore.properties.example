# Release signing configuration template.
#
# 1. Copy this file to android/keystore.properties and fill in your values.
#    keystore.properties (and the keystore itself) are gitignored.
# 2. Create a keystore once (keep it safe - losing it means you can never
#    publish an update to the same app identity):
#
#      keytool -genkeypair -v \
#        -keystore release-signing.jks \
#        -alias sportageobd \
#        -keyalg RSA -keysize 2048 -validity 10000
#
# 3. The Gradle build picks this up automatically and signs the release APK.
# 4. For CI, add these repository secrets and the workflow signs builds for you:
#      ANDROID_KEYSTORE_BASE64      -> base64 of the .jks file
#                                      (base64 -w0 release-signing.jks)
#      ANDROID_KEYSTORE_PASSWORD    -> store password
#      ANDROID_KEY_ALIAS            -> key alias (e.g. sportageobd)
#      ANDROID_KEY_PASSWORD         -> key password

storeFile=release-signing.jks
storePassword=CHANGE_ME
keyAlias=sportageobd
keyPassword=CHANGE_ME
