# Release signing configuration for Sportage OBD
# Copy this file to keystore.properties and fill in the real values.
# NEVER commit keystore.properties with real credentials.
#
# Environment variables take precedence over values in this file:
#   SPORTAGE_KEYSTORE_FILE
#   SPORTAGE_KEYSTORE_PASSWORD
#   SPORTAGE_KEY_ALIAS
#   SPORTAGE_KEY_PASSWORD

storeFile=/path/to/your/keystore.jks
storePassword=your_store_password
keyAlias=your_key_alias
keyPassword=your_key_password
