{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SportageOBD Theme Schema v2",
  "type": "object",
  "required": ["version", "id", "name", "tokens"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "enum": ["1.0", "1.1", "2.0"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,40}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "maxLength": 240 },
    "mode": { "type": "string", "enum": ["light", "dark", "system"] },
    "extends": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,40}$" },
    "widgetPresets": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "array",
        "maxItems": 12,
        "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,40}$" }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "surface": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "surfaceVariant": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "primary": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "secondary": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "accent": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "warning": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "danger": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "success": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "textPrimary": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "textSecondary": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "outline": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "gaugeTrack": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "gaugeFill": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "chart": {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" }
            }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fontFamily": { "type": "string", "enum": ["sans", "serif", "monospace", "cursive", "system"] },
            "numericFont": { "type": "string", "enum": ["sans", "serif", "monospace", "cursive", "system"] },
            "displayLarge": { "type": "number", "minimum": 8, "maximum": 96 },
            "displayMedium": { "type": "number", "minimum": 8, "maximum": 96 },
            "headlineLarge": { "type": "number", "minimum": 8, "maximum": 96 },
            "titleLarge": { "type": "number", "minimum": 8, "maximum": 96 },
            "titleMedium": { "type": "number", "minimum": 8, "maximum": 96 },
            "bodyLarge": { "type": "number", "minimum": 8, "maximum": 96 },
            "bodyMedium": { "type": "number", "minimum": 8, "maximum": 96 },
            "labelLarge": { "type": "number", "minimum": 8, "maximum": 96 },
            "labelMedium": { "type": "number", "minimum": 8, "maximum": 96 },
            "weightRegular": { "type": "integer", "minimum": 100, "maximum": 900 },
            "weightMedium": { "type": "integer", "minimum": 100, "maximum": 900 },
            "weightBold": { "type": "integer", "minimum": 100, "maximum": 900 },
            "letterSpacing": { "type": "number", "minimum": -0.1, "maximum": 0.2 }
          }
        },
        "shape": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "cornerRadius": { "type": "number", "minimum": 0, "maximum": 48 },
            "cardCornerRadius": { "type": "number", "minimum": 0, "maximum": 48 },
            "borderWidth": { "type": "number", "minimum": 0, "maximum": 8 },
            "gaugeStroke": { "type": "number", "minimum": 0.5, "maximum": 16 }
          }
        },
        "spacing": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "density": { "type": "string", "enum": ["compact", "comfortable", "spacious"] },
            "itemGap": { "type": "number", "minimum": 0, "maximum": 96 },
            "cardPadding": { "type": "number", "minimum": 0, "maximum": 96 },
            "safeMargin": { "type": "number", "minimum": 0, "maximum": 96 }
          }
        },
        "motion": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "fast": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "normal": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "slow": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "easing": { "type": "string", "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out", "spring"] }
          }
        },
        "elevation": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "cardElevation": { "type": "number", "minimum": 0, "maximum": 24 },
            "glowAlpha": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "iconography": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "style": { "type": "string", "enum": ["filled", "outlined"] },
            "strokeWidth": { "type": "number", "minimum": 1, "maximum": 8 }
          }
        },
        "background": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "style": { "type": "string", "enum": ["solid", "gradient", "pattern"] },
            "base": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "accent": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
            "gradientAngle": { "type": "integer", "minimum": 0, "maximum": 360 },
            "pattern": { "type": "string", "pattern": "^[a-z0-9-]{1,24}$" }
          }
        },
        "gauge": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "style": { "type": "string", "enum": ["radial", "bar", "digital", "arc", "minimal"] },
            "needle": { "type": "string", "enum": ["tapered", "line", "dot"] },
            "tickCount": { "type": "integer", "minimum": 0, "maximum": 60 },
            "warnFraction": { "type": "number", "minimum": 0, "maximum": 1 },
            "criticalFraction": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "layout": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "launcherRows": { "type": "integer", "minimum": 1, "maximum": 8 },
            "launcherCols": { "type": "integer", "minimum": 1, "maximum": 8 },
            "widgetMinWidth": { "type": "integer", "minimum": 96, "maximum": 400 },
            "widgetMinHeight": { "type": "integer", "minimum": 64, "maximum": 320 }
          }
        }
      }
    }
  }
}
