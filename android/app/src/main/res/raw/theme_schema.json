{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SportageOBD Theme Schema",
  "type": "object",
  "description": "Versioned theme configuration for SportageOBD cockpit. All UI reads from resolved theme tokens.",
  "required": ["tokens", "layout", "gaugeStyle", "meta"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0", "1.1", "2.0"],
      "default": "1.0",
      "description": "Schema version for backward-compatible migrations."
    },
    "mode": {
      "type": "string",
      "enum": ["light", "dark", "system"],
      "default": "dark",
      "description": "Color mode: light, dark, or follow system."
    },
    "tokens": {
      "type": "object",
      "required": ["color", "typography", "shape", "spacing", "elevation", "motion", "iconography", "background", "gauge", "layout"],
      "properties": {
        "color": {
          "type": "object",
          "required": ["background", "surface", "surfaceVariant", "primary", "secondary", "accent", "warning", "danger", "success", "textPrimary", "textSecondary", "outline", "gaugeTrack", "gaugeFill", "chart1", "chart2", "chart3"],
          "properties": {
            "background": {"type": "string", "format": "color"},
            "surface": {"type": "string", "format": "color"},
            "surfaceVariant": {"type": "string", "format": "color"},
            "primary": {"type": "string", "format": "color"},
            "secondary": {"type": "string", "format": "color"},
            "accent": {"type": "string", "format": "color"},
            "warning": {"type": "string", "format": "color"},
            "danger": {"type": "string", "format": "color"},
            "success": {"type": "string", "format": "color"},
            "textPrimary": {"type": "string", "format": "color"},
            "textSecondary": {"type": "string", "format": "color"},
            "outline": {"type": "string", "format": "color"},
            "gaugeTrack": {"type": "string", "format": "color"},
            "gaugeFill": {"type": "string", "format": "color"},
            "chart1": {"type": "string", "format": "color"},
            "chart2": {"type": "string", "format": "color"},
            "chart3": {"type": "string", "format": "color"}
          }
        },
        "typography": {
          "type": "object",
          "required": ["fontFamily", "sizes", "weights", "letterSpacing", "numericFont"],
          "properties": {
            "fontFamily": {"type": "string", "enum": ["system", "monospace", "roboto", "inter"]},
            "sizes": {
              "type": "object",
              "required": ["displayLarge", "displayMedium", "headlineLarge", "titleLarge", "titleMedium", "bodyLarge", "bodyMedium", "labelLarge", "labelMedium"],
              "properties": {
                "displayLarge": {"type": "number", "minimum": 12},
                "displayMedium": {"type": "number", "minimum": 12},
                "headlineLarge": {"type": "number", "minimum": 12},
                "titleLarge": {"type": "number", "minimum": 12},
                "titleMedium": {"type": "number", "minimum": 12},
                "bodyLarge": {"type": "number", "minimum": 12},
                "bodyMedium": {"type": "number", "minimum": 12},
                "labelLarge": {"type": "number", "minimum": 12},
                "labelMedium": {"type": "number", "minimum": 12}
              }
            },
            "weights": {
              "type": "object",
              "required": ["thin", "extraLight", "light", "regular", "medium", "semiBold", "bold", "extraBold", "black"],
              "properties": {
                "thin": {"type": "integer", "minimum": 100, "maximum": 900},
                "extraLight": {"type": "integer", "minimum": 100, "maximum": 900},
                "light": {"type": "integer", "minimum": 100, "maximum": 900},
                "regular": {"type": "integer", "minimum": 100, "maximum": 900},
                "medium": {"type": "integer", "minimum": 100, "maximum": 900},
                "semiBold": {"type": "integer", "minimum": 100, "maximum": 900},
                "bold": {"type": "integer", "minimum": 100, "maximum": 900},
                "extraBold": {"type": "integer", "minimum": 100, "maximum": 900},
                "black": {"type": "integer", "minimum": 100, "maximum": 900}
              }
            },
            "letterSpacing": {"type": "number"},
            "numericFont": {"type": "string", "enum": ["system", "monospace", "digital-7"]}
          }
        },
        "shape": {
          "type": "object",
          "required": ["cornerRadius", "borderWidth", "gaugeStroke"],
          "properties": {
            "cornerRadius": {"type": "number", "minimum": 0},
            "borderWidth": {"type": "number", "minimum": 0, "maximum": 20},
            "gaugeStroke": {"type": "number", "minimum": 1, "maximum": 20}
          }
        },
        "spacing": {
          "type": "object",
          "required": ["compact", "comfortable", "spacious"],
          "properties": {
            "compact": {"type": "number", "minimum": 0, "maximum": 50},
            "comfortable": {"type": "number", "minimum": 0, "maximum": 50},
            "spacious": {"type": "number", "minimum": 0, "maximum": 50}
          }
        },
        "elevation": {
          "type": "object",
          "required": "shadow"
        },
        "motion": {
          "type": "object",
          "required": ["durationFast", "durationNormal", "durationSlow", "easing"],
          "properties": {
            "durationFast": {"type": "integer", "minimum": 50, "maximum": 1000},
            "durationNormal": {"type": "integer", "minimum": 100, "maximum": 2000},
            "durationSlow": {"type": "integer", "minimum": 200, "maximum": 5000},
            "easing": {"type": "string", "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out", "cubic-bezier"]}
          }
        },
        "iconography": {
          "type": "object",
          "required": ["iconSet", "strokeWidth", "style"],
          "properties": {
            "iconSet": {"type": "string", "enum": ["material-icons", "material-outlined", "custom"]},
            "strokeWidth": {"type": "number", "minimum": 0, "maximum": 20},
            "style": {"type": "string", "enum": ["filled", "outlined", "rounded", "twotone"]}
          }
        },
        "background": {
          "type": "object",
          "required": ["style", "gradientColors", "imageResource", "safeAreaScrim"],
          "properties": {
            "style": {"type": "string", "enum": ["solid", "gradient", "image", "pattern"]},
            "gradientColors": {
              "type": "array",
              "items": {"type": "string", "format": "color"},
              "minItems": 2,
              "maxItems": 3
            },
            "imageResource": {"type": "string"},
            "safeAreaScrim": {"type": "string", "format": "color"}
          }
        },
        "gauge": {
          "type": "object",
          "required": ["style", "needleStyle", "tickStyle", "warningZones", "stylePreset"],
          "properties": {
            "style": {"type": "string", "enum": ["radial", "bar", "digital", "arc", "minimal"]},
            "needleStyle": {"type": "string", "enum": ["triangle", "arrow", "point", "minimal"]},
            "tickStyle": {"type": "string", "enum": ["none", "short", "long", "numbered"]},
            "warningZones": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["min", "max", "color"],
                "properties": {
                  "min": {"type": "number"},
                  "max": {"type": "number"},
                  "color": {"type": "string", "format": "color"}
                }
              },
              "minItems": 0,
              "maxItems": 6
            },
            "stylePreset": {"type": "string", "enum": ["performance", "analog", "minimal", "offroad", "night"]}
          }
        },
        "layout": {
          "type": "object",
          "required": ["preset", "launcherGrid", "clusterSlot", "safeMargins"],
          "properties": {
            "preset": {"type": "string", "enum": ["minimal", "performance", "analog", "offroad", "night"]},
            "launcherGrid": {
              "type": "object",
              "required": ["rows", "cols", "cellWidth", "cellHeight"],
              "properties": {
                "rows": {"type": "integer", "minimum": 1, "maximum": 20},
                "cols": {"type": "integer", "minimum": 1, "maximum": 20},
                "cellWidth": {"type": "integer", "minimum": 50},
                "cellHeight": {"type": "integer", "minimum": 50}
              }
            },
            "clusterSlot": {
              "type": "object",
              "required": ["widthRatio", "heightRatio"],
              "properties": {
                "widthRatio": {"type": "number", "minimum": 0.1, "maximum": 1.0},
                "heightRatio": {"type": "number", "minimum": 0.1, "maximum": 1.0}
              }
            },
            "safeMargins": {
              "type": "object",
              "required": ["top", "bottom", "left", "right"],
              "properties": {
                "top": {"type": "integer", "minimum": 0},
                "bottom": {"type": "integer", "minimum": 0},
                "left": {"type": "integer", "minimum": 0},
                "right": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "description": "Per-theme or per-user overrides on top of base tokens.",
      "properties": {
        "accent": {"type": "string", "format": "color"},
        "background": {"type": "string", "format": "color"},
        "gaugeStyle": {"type": "string", "enum": ["radial", "bar", "digital", "arc", "minimal"]},
        "density": {"type": "string", "enum": ["compact", "comfortable", "spacious"]},
        "fontScale": {"type": "number", "minimum": 0.85, "maximum": 1.5},
        "widgetLayout": {"type": "object"}
      }
    },
    "preview": {
      "type": "object",
      "description": "Thumbnail and description for theme gallery.",
      "required": ["thumbnail", "description"],
      "properties": {
        "thumbnail": {"type": "string", "format": "uri"},
        "description": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}