-+                    dashboardLayoutId = dashboardLayoutId,
-+                    onSetDashboardLayoutId = onSetDashboardLayoutId,
-+                    onNavigateBack = { currentRoute = null }
-+                )
-+            }
-+            "connectivity" -> {
-+                ConnectivitySettingsPage(
