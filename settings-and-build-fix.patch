-+                    onTogglePausePolling = onTogglePausePolling,
-+                    onOpenBluetoothSettings = onOpenBluetoothSettings,
-+                    viewModel = viewModel,
-+                    onNavigateBack = { currentRoute = null }
-+                )
-+            }
-+            "vehicle" -> {
