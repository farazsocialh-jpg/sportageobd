+                    }
+                }
+            }
+            DashboardDock(actions)
+        }
+    }
+}
+
+@Composable
+private fun SpeedWidget(data: DashboardData, actions: DashboardActions, modifier: Modifier = Modifier) {
+    DashboardPanel(modifier.testTag("widget_speed_panel")) {
+        Row(
+            modifier = Modifier.fillMaxWidth(),
