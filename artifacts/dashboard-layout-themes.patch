+            Text(data.rpm?.let { "$it" } ?: "--", color = WarningAmber(), fontSize = 14.sp, fontWeight = FontWeight.SemiBold)
+            Text(data.gearText, color = PrimaryText(), fontSize = 14.sp, fontWeight = FontWeight.SemiBold)
