+                            Text(
+                                text = "BLUETOOTH OBD2 INTERFACE",
+                                color = PrimaryText(),
+                                fontSize = 14.sp,
+                                fontWeight = FontWeight.Bold,
+                                fontFamily = FontFamily.SansSerif
+                            )
+                            Text(
