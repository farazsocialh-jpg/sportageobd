{
  "version": "2.0",
  "id": "minimal-daily",
  "name": "Minimal Daily",
  "description": "Light, uncluttered daily-driver cockpit. Soft surfaces, compact numerals and minimal motion.",
  "mode": "light",
  "tokens": {
    "color": {
      "background": "#F4F6F8",
      "surface": "#FFFFFFFF",
      "surfaceVariant": "#E7ECF0",
      "primary": "#1B2430",
      "secondary": "#52606D",
      "accent": "#0F766E",
      "warning": "#B45309",
      "danger": "#BE123C",
      "success": "#15803D",
      "textPrimary": "#141A21",
      "textSecondary": "#52606D",
      "outline": "#CBD5DB",
      "gaugeTrack": "#E2E8EC",
      "gaugeFill": "#0F766E",
      "chart": [
        "#0F766E",
        "#3B82F6",
        "#B45309"
      ]
    },
    "typography": {
      "fontFamily": "sans",
      "numericFont": "sans",
      "displayLarge": 38,
      "displayMedium": 30,
      "headlineLarge": 23,
      "titleLarge": 20,
      "titleMedium": 18,
      "bodyLarge": 16,
      "bodyMedium": 14,
      "labelLarge": 14,
      "labelMedium": 12,
      "weightRegular": 400,
      "weightMedium": 500,
      "weightBold": 600,
      "letterSpacing": 0.005
    },
    "shape": {
      "cornerRadius": 14,
      "cardCornerRadius": 20,
      "borderWidth": 1,
      "gaugeStroke": 6
    },
    "spacing": {
      "density": "spacious",
      "itemGap": 18,
      "cardPadding": 20,
      "safeMargin": 20
    },
    "motion": {
      "fast": 100,
      "normal": 180,
      "slow": 260,
      "easing": "ease-out"
    },
    "elevation": {
      "cardElevation": 3,
      "glowAlpha": 0
    },
    "iconography": {
      "style": "outlined",
      "strokeWidth": 1.5
    },
    "background": {
      "style": "solid",
      "base": "#F4F6F8",
      "accent": "#0F766E",
      "gradientAngle": 0,
      "pattern": "none"
    },
    "gauge": {
      "style": "digital",
      "needle": "line",
      "tickCount": 12,
      "warnFraction": 0.75,
      "criticalFraction": 0.9
    },
    "layout": {
      "launcherRows": 2,
      "launcherCols": 3,
      "widgetMinWidth": 160,
      "widgetMinHeight": 104
    }
  },
  "widgetPresets": [
    [
      "speed",
      "clock",
      "fuel",
      "voltage",
      "map",
      "connection"
    ]
  ]
}
